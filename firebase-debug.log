[debug] [2026-11-16T03:11:27.761Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/chamcongai-158f5/rulesets {"name":"projects/chamcongai-158f5/rulesets/5c8ab879-ad88-4ab4-ae00-2ddd82a68256","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isAdmin() {\r\n      return signedIn()\r\n        && exists(/databases/$(database)/documents/users/$(request.auth.uid))\r\n        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == \"admin\";\r\n    }\r\n\r\n    function validPhoto(field) {\r\n      return !(field in request.resource.data)\r\n        || (request.resource.data[field] is string\r\n          && request.resource.data[field].size() <= 250000);\r\n    }\r\n\r\n    function validProfilePhoto() {\r\n      return !('photoData' in request.resource.data)\r\n        || (request.resource.data.photoData is string\r\n          && request.resource.data.photoData.size() <= 200000);\r\n    }\r\n\r\n    match /users/{uid} {\r\n      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());\r\n      allow list: if isAdmin();\r\n      allow create: if (isAdmin() && validProfilePhoto())\r\n        || (signedIn() && request.auth.uid == uid\r\n          && request.resource.data.role == \"employee\" && validProfilePhoto());\r\n      allow update: if isAdmin()\r\n        && validProfilePhoto()\r\n        || (signedIn() && request.auth.uid == uid\r\n          && validProfilePhoto()\r\n          && request.resource.data.role == resource.data.role);\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /employeeCodes/{code} {\r\n      allow get: if signedIn();\r\n      allow list, update, delete: if false;\r\n      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;\r\n    }\r\n\r\n    match /faceProfiles/{uid} {\r\n      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());\r\n      allow list: if isAdmin();\r\n      allow create: if (isAdmin() || (signedIn() && request.auth.uid == uid))\r\n        && (!(\"descriptor\" in request.resource.data)\r\n          || (request.resource.data.descriptor is list && request.resource.data.descriptor.size() == 128))\r\n        && (!(\"maskedDescriptor\" in request.resource.data)\r\n          || (request.resource.data.maskedDescriptor is list && request.resource.data.maskedDescriptor.size() == 128));\r\n      allow update: if isAdmin()\r\n        || (signedIn()\r\n          && request.auth.uid == uid\r\n          && (!(\"descriptor\" in resource.data) || \"descriptor\" in request.resource.data)\r\n          && (!(\"maskedDescriptor\" in resource.data) || \"maskedDescriptor\" in request.resource.data)\r\n          && (!(\"descriptor\" in request.resource.data)\r\n            || (request.resource.data.descriptor is list && request.resource.data.descriptor.size() == 128))\r\n          && (!(\"maskedDescriptor\" in request.resource.data)\r\n            || (request.resource.data.maskedDescriptor is list && request.resource.data.maskedDescriptor.size() == 128)));\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /biometricConsents/{uid} {\r\n      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());\r\n      allow list: if isAdmin();\r\n      allow create, update: if signedIn()\r\n        && request.auth.uid == uid\r\n        && request.resource.data.keys().hasOnly([\"accepted\", \"policyVersion\", \"acceptedAt\"])\r\n        && request.resource.data.accepted == true\r\n        && request.resource.data.policyVersion == \"2026-11-v1\"\r\n        && request.resource.data.acceptedAt == request.time;\r\n      allow delete: if signedIn() && request.auth.uid == uid;\r\n    }\r\n\r\n    match /attendance/{recordId} {\r\n      allow get: if isAdmin()\r\n        || (signedIn() && (\r\n          !exists(/databases/$(database)/documents/attendance/$(recordId))\r\n          || resource.data.employeeUid == request.auth.uid\r\n        ));\r\n      allow list: if isAdmin()\r\n        || (signedIn() && resource.data.employeeUid == request.auth.uid);\r\n      allow create: if isAdmin()\r\n        || (signedIn()\r\n          && request.resource.data.employeeUid == request.auth.uid\r\n          && request.resource.data.keys().hasOnly([\r\n            \"employeeUid\", \"employeeName\", \"employeeId\", \"workDate\", \"shift\",\r\n            \"checkIn\", \"checkInTimestamp\", \"checkInServerTimestamp\", \"status\",\r\n            \"checkInPhotoData\", \"checkOut\", \"checkOutTimestamp\",\r\n            \"checkOutServerTimestamp\", \"checkOutPhotoData\", \"updatedAt\",\r\n            \"migratedFromLegacy\"\r\n          ])\r\n          && request.resource.data.checkInServerTimestamp == request.time\r\n          && request.resource.data.checkInTimestamp is number\r\n          && request.resource.data.workDate is string\r\n          && request.resource.data.workDate.matches(\"^[0-9]{4}-[0-9]{2}-[0-9]{2}$\")\r\n          && validPhoto(\"checkInPhotoData\")\r\n          && validPhoto(\"checkOutPhotoData\")\r\n          && (!(\"checkOutServerTimestamp\" in request.resource.data)\r\n            || request.resource.data.checkOutServerTimestamp == request.time));\r\n      allow update: if isAdmin()\r\n        || (signedIn()\r\n          && resource.data.employeeUid == request.auth.uid\r\n          && request.resource.data.employeeUid == request.auth.uid\r\n          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\r\n            \"checkOut\", \"checkOutTimestamp\", \"checkOutServerTimestamp\",\r\n            \"checkOutPhotoData\", \"updatedAt\"\r\n          ])\r\n          && request.resource.data.checkOutServerTimestamp == request.time\r\n          && request.resource.data.checkOutTimestamp is number\r\n          && validPhoto(\"checkOutPhotoData\"));\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /payrollSettings/{settingId} {\r\n      allow read, write: if isAdmin();\r\n    }\r\n\r\n    match /departments/{departmentId} {\r\n      allow read: if isAdmin();\r\n      allow create: if isAdmin()\r\n        && request.resource.data.keys().hasOnly([\"name\", \"createdBy\", \"createdAt\"])\r\n        && request.resource.data.name is string\r\n        && request.resource.data.name.size() > 0\r\n        && request.resource.data.name.size() <= 60\r\n        && request.resource.data.createdBy == request.auth.uid\r\n        && request.resource.data.createdAt == request.time;\r\n      allow update: if false;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /employeeMetadata/{uid} {\r\n      allow read: if isAdmin();\r\n      allow create, update: if isAdmin()\r\n        && request.resource.data.keys().hasOnly([\r\n          \"departmentId\", \"employmentStatus\", \"updatedBy\", \"updatedAt\"\r\n        ])\r\n        && request.resource.data.departmentId is string\r\n        && (request.resource.data.departmentId == \"\"\r\n          || exists(/databases/$(database)/documents/departments/$(request.resource.data.departmentId)))\r\n        && request.resource.data.employmentStatus in [\"active\", \"inactive\"]\r\n        && request.resource.data.updatedBy == request.auth.uid\r\n        && request.resource.data.updatedAt == request.time;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /shifts/{shiftId} {\r\n      allow read: if isAdmin();\r\n      allow create: if isAdmin()\r\n        && request.resource.data.keys().hasOnly([\r\n          \"name\", \"start\", \"end\", \"graceMinutes\", \"days\", \"employeeUids\",\r\n          \"createdBy\", \"createdAt\", \"updatedBy\", \"updatedAt\"\r\n        ])\r\n        && request.resource.data.name is string\r\n        && request.resource.data.name.size() > 0\r\n        && request.resource.data.name.size() <= 50\r\n        && request.resource.data.start.matches(\"^([01][0-9]|2[0-3]):[0-5][0-9]$\")\r\n        && request.resource.data.end.matches(\"^([01][0-9]|2[0-3]):[0-5][0-9]$\")\r\n        && request.resource.data.graceMinutes is int\r\n        && request.resource.data.graceMinutes >= 0\r\n        && request.resource.data.graceMinutes <= 180\r\n        && request.resource.data.days is list\r\n        && request.resource.data.days.size() > 0\r\n        && request.resource.data.days.size() <= 7\r\n        && request.resource.data.days.hasOnly([\"T2\", \"T3\", \"T4\", \"T5\", \"T6\", \"T7\", \"CN\"])\r\n        && request.resource.data.employeeUids is list\r\n        && request.resource.data.employeeUids.size() <= 100\r\n        && request.resource.data.createdBy == request.auth.uid\r\n        && request.resource.data.updatedBy == request.auth.uid\r\n        && request.resource.data.createdAt == request.time\r\n        && request.resource.data.updatedAt == request.time;\r\n      allow update: if isAdmin()\r\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\r\n          \"name\", \"start\", \"end\", \"graceMinutes\", \"days\", \"employeeUids\",\r\n          \"updatedBy\", \"updatedAt\"\r\n        ])\r\n        && request.resource.data.updatedBy == request.auth.uid\r\n        && request.resource.data.updatedAt == request.time;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /systemSettings/{settingId} {\r\n      allow read: if isAdmin() || (signedIn() && settingId == \"emailAlert\");\r\n      allow create, update: if isAdmin()\r\n        && request.resource.data.keys().hasOnly([\"url\", \"updatedBy\", \"updatedAt\"])\r\n        && request.resource.data.url is string\r\n        && request.resource.data.url.size() <= 2048\r\n        && request.resource.data.updatedBy == request.auth.uid\r\n        && request.resource.data.updatedAt == request.time;\r\n      allow delete: if isAdmin();\r\n    }\r\n\r\n    match /employeeRequests/{requestId} {\r\n      allow get, list: if isAdmin()\r\n        || (signedIn() && resource.data.employeeUid == request.auth.uid);\r\n      allow create: if signedIn()\r\n        && request.resource.data.keys().hasOnly([\r\n          \"employeeUid\", \"employeeName\", \"type\", \"startDate\", \"endDate\",\r\n          \"details\", \"status\", \"createdAt\"\r\n        ])\r\n        && request.resource.data.employeeUid == request.auth.uid\r\n        && request.resource.data.employeeName\r\n          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name\r\n        && request.resource.data.type in [\"correction\", \"leave\"]\r\n        && request.resource.data.startDate.matches(\"^[0-9]{4}-[0-9]{2}-[0-9]{2}$\")\r\n        && request.resource.data.endDate.matches(\"^[0-9]{4}-[0-9]{2}-[0-9]{2}$\")\r\n        && request.resource.data.details is string\r\n        && request.resource.data.details.size() > 0\r\n        && request.resource.data.details.size() <= 400\r\n        && request.resource.data.status == \"pending\"\r\n        && request.resource.data.createdAt == request.time;\r\n      allow update: if isAdmin()\r\n        && resource.data.status == \"pending\"\r\n        && request.resource.data.status in [\"approved\", \"rejected\"]\r\n        && request.resource.data.reviewedBy == request.auth.uid\r\n        && request.resource.data.reviewedAt == request.time\r\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\r\n          \"status\", \"reviewedBy\", \"reviewedAt\"\r\n        ]);\r\n      allow delete: if false;\r\n    }\r\n\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-11-16T03:11:27.526703Z","metadata":{"services":["cloud.firestore"]}}
