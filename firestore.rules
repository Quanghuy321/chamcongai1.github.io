rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function validPhoto(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
          && request.resource.data[field].size() <= 250000);
    }

    function validProfilePhoto() {
      return !('photoData' in request.resource.data)
        || (request.resource.data.photoData is string
          && request.resource.data.photoData.size() <= 200000);
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if (isAdmin() && validProfilePhoto())
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.role == "employee" && validProfilePhoto());
      allow update: if isAdmin()
        && validProfilePhoto()
        || (signedIn() && request.auth.uid == uid
          && validProfilePhoto()
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /employeeCodes/{code} {
      allow get: if signedIn();
      allow list, update, delete: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /faceProfiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if (isAdmin() || (signedIn() && request.auth.uid == uid))
        && (!("descriptor" in request.resource.data)
          || (request.resource.data.descriptor is list && request.resource.data.descriptor.size() == 128))
        && (!("maskedDescriptor" in request.resource.data)
          || (request.resource.data.maskedDescriptor is list && request.resource.data.maskedDescriptor.size() == 128));
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && (!("descriptor" in resource.data) || "descriptor" in request.resource.data)
          && (!("maskedDescriptor" in resource.data) || "maskedDescriptor" in request.resource.data)
          && (!("descriptor" in request.resource.data)
            || (request.resource.data.descriptor is list && request.resource.data.descriptor.size() == 128))
          && (!("maskedDescriptor" in request.resource.data)
            || (request.resource.data.maskedDescriptor is list && request.resource.data.maskedDescriptor.size() == 128)));
      allow delete: if isAdmin();
    }

    match /biometricConsents/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["accepted", "policyVersion", "acceptedAt"])
        && request.resource.data.accepted == true
        && request.resource.data.policyVersion == "2026-11-v1"
        && request.resource.data.acceptedAt == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /attendance/{recordId} {
      allow get: if isAdmin()
        || (signedIn() && (
          !exists(/databases/$(database)/documents/attendance/$(recordId))
          || resource.data.employeeUid == request.auth.uid
        ));
      allow list: if isAdmin()
        || (signedIn() && resource.data.employeeUid == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn()
          && request.resource.data.employeeUid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            "employeeUid", "employeeName", "employeeId", "workDate", "shift",
            "checkIn", "checkInTimestamp", "checkInServerTimestamp", "status",
            "checkInPhotoData", "checkOut", "checkOutTimestamp",
            "checkOutServerTimestamp", "checkOutPhotoData", "updatedAt",
            "migratedFromLegacy"
          ])
          && request.resource.data.checkInServerTimestamp == request.time
          && request.resource.data.checkInTimestamp is number
          && request.resource.data.workDate is string
          && request.resource.data.workDate.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
          && validPhoto("checkInPhotoData")
          && validPhoto("checkOutPhotoData")
          && (!("checkOutServerTimestamp" in request.resource.data)
            || request.resource.data.checkOutServerTimestamp == request.time));
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.employeeUid == request.auth.uid
          && request.resource.data.employeeUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "checkOut", "checkOutTimestamp", "checkOutServerTimestamp",
            "checkOutPhotoData", "updatedAt"
          ])
          && request.resource.data.checkOutServerTimestamp == request.time
          && request.resource.data.checkOutTimestamp is number
          && validPhoto("checkOutPhotoData"));
      allow delete: if isAdmin();
    }

    match /payrollSettings/{settingId} {
      allow read, write: if isAdmin();
    }

  }
}
