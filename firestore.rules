rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function validPhoto(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
          && request.resource.data[field].size() <= 250000);
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid && request.resource.data.role == "employee");
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    match /employeeCodes/{code} {
      allow get: if signedIn();
      allow list, update, delete: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /faceProfiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    match /attendance/{recordId} {
      allow get, list: if isAdmin()
        || (signedIn() && resource.data.employeeUid == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.employeeUid == request.auth.uid
          && validPhoto("checkInPhotoData")
          && validPhoto("checkOutPhotoData"));
      allow update: if isAdmin()
        || (signedIn() && resource.data.employeeUid == request.auth.uid
          && request.resource.data.employeeUid == request.auth.uid
          && validPhoto("checkInPhotoData")
          && validPhoto("checkOutPhotoData"));
      allow delete: if isAdmin();
    }
  }
}
